  - speakerVoice: {fileID: 8300000, guid: 5476a1a0afb172e4986479c166b93983, type: 3}
    voicePitch: 1
    speakerName: 'Silly Billy:'
    speakerDescription: '"Hey-Hey...It''s me...the most Silliest of Billy..."'
  - speakerVoice: {fileID: 8300000, guid: 5476a1a0afb172e4986479c166b93983, type: 3}
    voicePitch: 1
    speakerName: 'Silly Billy:'
    speakerDescription: '"I came here to just..."'
  - speakerVoice: {fileID: 8300000, guid: 5476a1a0afb172e4986479c166b93983, type: 3}
    voicePitch: 1
    speakerName: 'Silly Billy:'
    speakerDescription: '"AHEM..."'
  - speakerVoice: {fileID: 8300000, guid: 5476a1a0afb172e4986479c166b93983, type: 3}
    voicePitch: 1
    speakerName: 'Silly Billy:'
    speakerDescription: '"Visit my dearest mother..."'
  - speakerVoice: {fileID: 8300000, guid: 5476a1a0afb172e4986479c166b93983, type: 3}
    voicePitch: 1
    speakerName: 'Silly Billy:'
    speakerDescription: '"Silly...I know..."'
  dialogueOptions:
  - optionText: Right...Visit your Mother...
