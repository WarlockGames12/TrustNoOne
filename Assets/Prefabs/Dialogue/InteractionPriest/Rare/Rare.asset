  dialogueEntries:
  - speakerVoice: {fileID: 8300000, guid: aa7824050ba3146468003605e0352007, type: 3}
    voicePitch: 0.85
    speakerName: 'Priest:'
    speakerDescription: '"It is rare..."'
  - speakerVoice: {fileID: 8300000, guid: aa7824050ba3146468003605e0352007, type: 3}
